{
  "name": "pdf2anki",
  "version": "1.0.0",
  "description": "Converts PDF files to Anki decks using LangChain agents and Gemini",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@langchain/community": "^1.1.27",
    "@langchain/core": "^1.1.38",
    "@langchain/google-vertexai": "^2.1.26",
    "@langchain/langgraph": "^1.2.6",
    "@types/prompts": "^2.4.9",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^16.4.5",
    "jszip": "^3.10.1",
    "p-limit": "^7.3.0",
    "pdf-parse": "^1.1.1",
    "prompts": "^2.4.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  }
}
